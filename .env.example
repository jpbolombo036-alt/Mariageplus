# Base de données
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/mariageplusdb
SPRING_DATASOURCE_USERNAME=user
SPRING_DATASOURCE_PASSWORD=password

# JWT (obligatoire : clé HMAC d'au moins 256 bits / 32 octets)
JWT_SECRET=please-change-this-mariageplus-secret-key-32-bytes-min

# Application
SERVER_PORT=8000
# Origines autorisées pour le CORS — en production, y mettre l'URL du front :
# CORS_ALLOWED_ORIGINS=https://mariaplus-web.vercel.app
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Premier compte SUPER_ADMIN — désactivé par défaut en production.
# local  : application-local.yml active ADMIN_INIT_ENABLED par défaut (développement).
# prod   : ADMIN_INIT_ENABLED=false par défaut → AUCUNE création automatique.
# Initialisation ponctuelle du premier SUPER_ADMIN :
#   ADMIN_INIT_ENABLED=true
#   ADMIN_INIT_EMAIL=admin@votredispositif.com
#   ADMIN_INIT_PASSWORD=mot_de_passe_fort_et_secret
#   (puis repasser ADMIN_INIT_ENABLED=false)
ADMIN_INIT_ENABLED=false
ADMIN_INIT_EMAIL=
ADMIN_INIT_PASSWORD=

# Email (invitations / notifications)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
MAIL_FROM=noreply@mariageplus.local

# URL du front — utilisée pour :
#   1) les liens des emails d'invitation (InvitationMailService)
#   2) la redirection GET /invitations/{token} vers la page web d'invitation
# Production : https://mariaplus-web.vercel.app (défaut de application.yml)
FRONTEND_URL=https://mariaplus-web.vercel.app

# --- Stockage objet S3-compatible (photos de profil) -------------------------
# Railway : il suffit de LIER le bucket Tigris au service backend — les variables
# AWS_S3_* sont injectées automatiquement. Sinon, définis manuellement :
#   S3_ENDPOINT (vide pour AWS ; https://t3.storageapi.dev pour Tigris/Railway)
#   S3_REGION=auto (Tigris) | S3_BUCKET | S3_ACCESS_KEY | S3_SECRET_KEY
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
# Optionnel : URL publique du bucket/CDN si tu veux exposer directement les images
S3_PUBLIC_BASE_URL=

# --- WhatsApp (Cloud API Meta) — envoi en masse des invitations --------------
# Actif si WHATSAPP_TOKEN et WHATSAPP_PHONE_NUMBER_ID sont définis.
# Prérequis : app Meta + numéro WhatsApp Business dédié + template approuvé
# (nom par défaut : invitation_mariage ; langue fr).
WHATSAPP_API_VERSION=v23.0
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TEMPLATE_NAME=invitation_mariage
WHATSAPP_TEMPLATE_LANGUAGE=fr
# Indicatif pays pour normaliser les numéros locaux (ex : 243 pour la RDC)
WHATSAPP_DEFAULT_COUNTRY_CODE=
# Cadencement entre deux messages en ms (2000 = 30 messages/minute)
WHATSAPP_BULK_DELAY_MS=2000
# URL publique de cette API (en-tête image du template WhatsApp) :
# ex : https://mariageplus-prod.up.railway.app
PUBLIC_API_BASE_URL=
# (Optionnel) URL de base des liens d'invitation — prioritaire sur APP_FRONTEND_URL
# si les pages /invitations/{token} sont servies par cette API.
APP_PUBLIC_URL=
